# Where secrets are kept:
#   file     = in this .env file and token.json (default)
#   keychain = in the OS keychain (Windows Credential Manager, macOS Keychain,
#              Linux Secret Service). Save them with: python kcls_secrets.py set ...
#              and then leave EMAIL_USER, EMAIL_PASS and TODOIST_API_TOKEN out of .env.
SECRET_STORAGE=file

# How to log in to Gmail:
#   default = opens a Google sign-in window on the first run (recommended)
#   legacy  = uses EMAIL_USER and EMAIL_PASS (a Gmail App Password)
EMAIL_LOGIN_TYPE=default

# Only needed when EMAIL_LOGIN_TYPE=legacy
EMAIL_USER=example@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

TODOIST_API_TOKEN= your 40 character Todoist API key

TASK_MANAGER=todoist/google
GOOGLE_TASKLIST_NAME=KCLS Stuff
TODOIST_PROJECT_NAME=KCLS Stuff